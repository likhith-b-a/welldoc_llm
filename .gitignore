# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Python build
build/
dist/
*.egg-info/

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*

# -------------------------
# Jupyter / temp files
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# OS Files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# ChromaDB (IMPORTANT)
# -------------------------
# chroma_db/ (Commented out so the DB gets pushed to GitHub for Streamlit Cloud)

# (Optional: remove this line if you WANT to push DB to repo)

# -------------------------
# Ollama / Model artifacts
# -------------------------
*.bin
*.gguf
*.model

# -------------------------
# Large data files
# -------------------------
*.sqlite3
*.db

# -------------------------
# Streamlit cache
# -------------------------
# .streamlit/ (Commented out so config.toml gets pushed)
.streamlit/secrets.toml

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
*.tmp

# -------------------------
# Force-include the prebuilt vector store
# (overrides *.bin / *.sqlite3 / *.db above so Streamlit Cloud gets it)
# -------------------------
!chroma_db/**
